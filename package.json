{
  "name": "zoho-analytics-codemode",
  "version": "2.0.0",
  "description": "UTCP code mode for Zoho Analytics \u2014 an MCP server that lets AI agents write and run sandboxed code against the Analytics v2 API, with the OKF knowledge base built in",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/sathishkumar-ks-8646/za-codemode#readme",
  "keywords": [
    "zoho",
    "analytics",
    "mcp",
    "model-context-protocol",
    "utcp",
    "code-mode",
    "ai-agent",
    "code-execution"
  ],
  "bin": {
    "zoho-analytics-codemode": "src/bin.mjs",
    "za-codemode": "src/bin.mjs",
    "za-codemode-remote": "src/remote.mjs"
  },
  "main": "src/bin.mjs",
  "files": [
    "src/",
    "manual/",
    "knowledge/",
    "LICENSE.md",
    "README.md"
  ],
  "scripts": {
    "start": "node src/server.mjs",
    "build:manual": "node tools/build-manual.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:agent": "node test/agent.test.mjs",
    "start:remote": "node src/remote.mjs",
    "build:knowledge": "node tools/build-knowledge.mjs",
    "build": "npm run build:manual && npm run build:knowledge",
    "verify:knowledge": "node tools/build-knowledge.mjs --verify",
    "login": "node src/bin.mjs login",
    "status": "node src/bin.mjs status"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@utcp/code-mode": "^1.2.13",
    "@utcp/http": "^1.1.14",
    "@utcp/sdk": "^1.2.0",
    "@utcp/text": "^1.1.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "redis": "^6.3.1",
    "@napi-rs/keyring": "^2.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sathishkumar-ks-8646/za-codemode.git"
  },
  "bugs": {
    "url": "https://github.com/sathishkumar-ks-8646/za-codemode/issues"
  }
}
