# Zoho Analytics Code Mode — remote server
#
# Variable names mirror the self-hosted Zoho Analytics Remote MCP Server, so an
# existing .env can largely be reused.

# --- Required -----------------------------------------------------------
# Your data centre's Analytics API host.
ANALYTICS_SERVER_URL=https://analyticsapi.zoho.com

# A SERVER-BASED OAuth application from https://api-console.zoho.com
# (not a Self Client — Self Clients cannot do redirect-based OAuth).
OIDC_PROVIDER_CLIENT_ID=1000.XXXXXXXXXXXXXXXX
OIDC_PROVIDER_CLIENT_SECRET=your-client-secret

# The public HTTPS URL this server is reachable at. The redirect URI you
# register in the Developer Console must be exactly <this>/auth/callback
MCP_SERVER_PUBLIC_URL=https://analytics-code.example.com

# Signs and encrypts sessions. Generate with: openssl rand -base64 48
SESSION_SECRET_KEY=replace-me-with-at-least-32-random-characters

# Access control. Comma-separated Organization IDs whose users may use this
# server. A user with access to none of them is refused at sign-in.
MCP_SERVER_ORG_IDS=2375824000000000001,2375824000000000002

# --- Optional -----------------------------------------------------------
# PORT=4000

# Derived from ANALYTICS_SERVER_URL; set it only if that guess is wrong.
# ACCOUNTS_SERVER_URL=https://accounts.zoho.com

# Number of reverse proxies in front of this server. Must be exact: too high
# and clients can spoof X-Forwarded-For past the rate limiter.
# TRUST_PROXY_HOPS=1

# memory (default, single instance only) or redis (required for >1 replica).
# STORAGE_BACKEND=redis
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Which API domains this deployment serves. Empty or unset means all ten.
# A smaller surface is safer and measurably improves search precision.
#   data-modeling-schema  data-operations       dsml
#   org-management        reports-dashboards    schedules-alerts
#   share-publish         user-groups           views-management
#   workspace-management
# ZA_DOMAINS=data-operations,views-management,reports-dashboards

# DANGER: exposes write operations (create, update, DELETE) for every user.
# ZA_ALLOW_WRITES=false

# --- Audit logging ------------------------------------------------------
# Two streams: api.jsonl is one line per outbound Zoho call; detail.jsonl is
# one record per tool call, including the program that ran.
#   off | api | full        (default: api)
# ZA_AUDIT=api
# ZA_AUDIT_DIR=/var/log/zoho-analytics-code-mode
# ZA_AUDIT_MAX_FILE_MB=10
# ZA_AUDIT_API_FILES=10          # 10 x 10 MB = 100 MB of API history
# ZA_AUDIT_DETAIL_FILES=10       # and the same again for the detail stream
# ZA_AUDIT_LOG_CODE=true         # record the program a model wrote
# ZA_AUDIT_HASH_CHAIN=true       # per-line hashes, for tamper detection
# ZA_AUDIT_STDOUT=true           # JSON Lines on stdout for a collector

# DANGER: writes access tokens and client secrets to disk in clear text.
# For debugging one machine, never for a deployment.
# ZA_AUDIT_LOG_SECRETS=false

# Sandbox limits.
# ZA_MAX_TOOL_CALLS=200
# ZA_EXEC_TIMEOUT_MS=60000
# ZA_EXEC_MEMORY_MB=256

# Session pool.
# ZA_MAX_SESSIONS=100
# ZA_SESSION_IDLE_MS=1800000
